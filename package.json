{
  "name": "9agent",
  "version": "0.6.0",
  "description": "Universal 9Router agent launcher — discover models, pick agent, launch.",
  "license": "MIT",
  "author": "Omar Faruque Tuhin",
  "homepage": "https://github.com/nadimtuhin/9agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadimtuhin/9agent.git"
  },
  "bugs": {
    "url": "https://github.com/nadimtuhin/9agent/issues"
  },
  "keywords": [
    "9router",
    "cli",
    "llm",
    "agent",
    "claude",
    "launcher"
  ],
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "9agent": "bin/9agent.js"
  },
  "files": [
    "dist",
    "bin",
    "docker",
    "CHANGELOG.md",
    "CONTEXT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predeploy": "bash scripts/stamp-version.sh",
    "deploy": "wrangler pages deploy site --project-name=9agent --branch=main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "tsx src/index.ts",
    "test:docker": "bash test/run-docker-tests.sh",
    "test": "node --test --import tsx src/adapters/__test__/*.test.ts",
    "prepack": "npm run build",
    "check": "bash scripts/checks.sh",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-no-comments": "^1.2.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=20"
  }
}
